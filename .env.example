# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# e.g. postgresql://user:password@localhost:5432/tdc_db?schema=public
# or cloud hosted Neon/Supabase url: postgresql://username:password@ep-xyz.aws.neon.tech/tdc_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tdc_matchmaking?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-key-for-tdc-matchmaking-mvp-2026"
JWT_EXPIRES_IN="7d"

# OpenAI Integration (Optional - Falls back cleanly if key is omitted or fails)
OPENAI_API_KEY=""

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Frontend (set in Vercel): URL of the deployed backend, e.g. https://your-api.onrender.com
# VITE_API_URL=
